# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAVILY_API_KEY=your_tavily_key_here
# vLLM fallback (only needed if running a GPU node)
VLLM_BASE_URL=http://localhost:8000/v1

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Postgres (used by Supabase or standalone) ──────────────────────────────────
# Option 1 (recommended): paste the full connection string from Supabase
#   Settings → Database → Connection string → URI  (use the "Direct connection" one)
#   Replace [YOUR-DB-PASSWORD] with your Supabase DB password.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Option 2: fill in the individual fields (used only when DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=eval_canvas_docs

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_256_bit_secret
ENVIRONMENT=development
LOG_LEVEL=info

# ── Frontend (Next.js — must be prefixed with NEXT_PUBLIC_) ───────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
